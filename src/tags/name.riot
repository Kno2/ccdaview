<name>
  <span class={ props.class }>{ props.name.given[0] } { props.name.family }{ state.possesive }</span>

  <script>
    export default {
      state: {
        possesive: ''
      },

      onBeforeMount(props, state) {
        if (props.possesive) {
          state.possesive = props.name.family.slice(-1) === 's' ? '\'' : '\'s';
        }
      }
    }
  </script>
</name>
