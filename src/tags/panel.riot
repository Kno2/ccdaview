<panel>
  <div class={ 'panel panel-' + (props.state || 'default') } id={ props.section.key }>
    <div class="panel-heading section-toggle" onclick={ toggleSection }>
      <h3 class="panel-title">
        <i class={ 'fa fa-' + props.section.icon + ' section-icon' } aria-hidden="true" if={ !props.hideicon }></i>{ ' ' + props.section.display }
        { ' ' }<span class="text-muted" if={ isEmpty() }>(empty)</span>
        <span class="pull-right">
          <i class={ 'fa fa-chevron-down' + (props.section.enabled ? ' fa-rotate-180' : '') } aria-hidden="true"></i>
        </span>
      </h3>
    </div>
    <div class="panel-body">
      <slot/>
    </div>
  </div>

  <script>
    export default {
      _currentData: null,

      onBeforeUpdate(props, state) {
        if (props.data !== this._currentData) {
          this._currentData = props.data;
          if (this.isEmpty()) props.section.enabled = false;
        }
      },

      onMounted() {
        this.updateRootClasses();
      },

      onUpdated() {
        this.updateRootClasses();
      },

      updateRootClasses() {
        var classes = this.props.section.tagName;
        classes += this.isEmpty() ? ' fade' : '';
        classes += this.isEnabled() ? ' expanded' : ' collapsed';
        this.root.className = classes;
      },

      isEmpty() {
        return !this.props.data.text;
      },

      isEnabled() {
        return this.props.section.enabled || this.props.enabled;
      },

      toggleSection(e) {
        e.preventDefault();
        this.props.section.enabled = !this.props.section.enabled;
        this.update();
      }
    }
  </script>
</panel>
