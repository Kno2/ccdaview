{
    "compilerOptions": {
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "module": "commonjs",
        "target": "es5",
        "noImplicitAny": false,
        "sourceMap": true,
        "declaration": true,
        "declarationDir": "dist",
        "outDir": "dist",
        "lib": ["es2016", "dom"]
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*"],
    // Atom settings
    "compileOnSave": false
}
